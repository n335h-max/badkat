{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BadKat",
  "version": "0.2.0",
  "identifier": "app.badkat.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyNDAzM0QxMzMwOUYyNUYKUldSZjhna3owVE5BTWd3M1JXWUVQVEtZZll1SnVOdDhZV25HRGRKVUJGLzd4RTFQR0Q3WlZDdmsK",
      "endpoints": [
        "https://github.com/X-DIABLO-X/badkat/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "A desktop cat that closes your doomscrolling.",
    "longDescription": "BadKat patrols the bottom of your screen. When Shorts, Reels, TikTok or a streaming site holds the foreground for too long, it storms over and closes it."
  }
}
